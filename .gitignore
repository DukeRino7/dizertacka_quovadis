# Pôvodné dáta (sťahujú sa z Hugging Face, pozri data/CLAUDE.md)
data/*
!data/CLAUDE.md

# Predspracované dáta – veľké súbory sú znovu vytvoriteľné zo src/data; dokumentácia, štatistiky a grafy sa verzujú
processed/**/*.npy
processed/**/*.parquet
# spoločný index a rozdelenie sa verzuje (malý; zaručuje rovnaké vzorky na všetkých počítačoch)
!processed/index/*.parquet

# Uložené modely v behoch (veľké súbory); metriky, predikcie a grafy sa verzujú
runs/**/model/

# finálny beh má vlastný priečinok; modely v ňom sa necommitujú (rovnako ako v runs/)
runs_final/**/model/
runs_v*/**/model/
runs_predbezne/**/model/

# Python prostredie a dočasné súbory
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Lokálne nastavenia Claude Code
.claude/settings.local.json

# Systém / editor
Thumbs.db
desktop.ini
.vscode/
.idea/

# skúšobný beh V2 (iba technická kontrola)
runs_v2_smoke/
processed/dynamic/lofo/
