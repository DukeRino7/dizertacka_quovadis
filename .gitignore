# Pôvodné dáta (sťahujú sa z Hugging Face, pozri data/CLAUDE.md)
data/*
!data/CLAUDE.md

# Predspracované dáta – veľké súbory sú znovu vytvoriteľné zo src/data; dokumentácia, štatistiky a grafy sa verzujú
processed/**/*.npy
processed/**/*.parquet

# Uložené modely v behoch (veľké súbory); metriky, predikcie a grafy sa verzujú
runs/**/model/

# Python prostredie a dočasné súbory
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Lokálne nastavenia Claude Code
.claude/settings.local.json

